# Copy to .env (gitignored) and fill in. Never commit real keys.

# Meta Model API
MODEL_API_KEY=
META_API_BASE_URL=

# Baseten (Meta open-weights models)
BASETEN_API_KEY=
# BASETEN_BASE_URL=https://inference.baseten.co/v1

# Optional per-role overrides: ATTEST_ROUTE_<ROLE>=provider:model
# Roles: WORKER, REASONING, IMAGE, UI, VERIFIER, JUDGE. Providers: meta, baseten.
# ATTEST_ROUTE_JUDGE=meta:muse-wonder-1.0   (the judge uses Spark Open on Baseten whenever BASETEN_API_KEY is set)
# Own Baseten accounts serve meta-models/muse-spark-open (the hackathon key used ...-1026).

# Use the cheaper Spark Contributor tier for workers on the Meta API (content may train Meta models)
# ATTEST_CONTRIBUTOR=1
