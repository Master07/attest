{
  "name": "attest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Proof-of-fix for AI pull requests: reproduce the bug, confirm the fix, catch a wrong fix, seal a verifiable receipt.",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "smoke": "tsx scripts/smoke-t4.ts",
    "phase": "tsx scripts/run-phase.ts",
    "attest": "tsx src/index.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "playwright": "^1.64.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "optionalDependencies": {
    "@muse-code/sdk": "*"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  }
}
